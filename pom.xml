<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.cadenzaflow.bpm.extension</groupId>
  <artifactId>cadenzaflow-keycloak-root</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>CadenzaFlow - engine plugins - identity - keycloak - root</name>
  <description>
    CadenzaFlow Identity Provider Plugin for Keycloak. Fork of
    cibseven-keycloak (the maintained continuation of the EOL
    camunda-platform-7-keycloak community plugin), re-namespaced to
    org.cadenzaflow and built against the CadenzaFlow engine (Java 11,
    spring-web 5.x / httpclient 4.x so it runs on every supported runtime).
  </description>
  <url>https://github.com/cadenzaflow/cadenzaflow-keycloak</url>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <version.java>11</version.java>

    <!-- the engine this plugin is built and tested against -->
    <version.cadenzaflow>1.2.0</version.cadenzaflow>

    <!-- Java 11 compatible dependency line (spring-web 6 / httpclient5 need Java 17) -->
    <version.spring-web>5.3.39</version.spring-web>
    <version.httpclient>4.5.14</version.httpclient>
    <version.commons-codec>1.17.1</version.commons-codec>
    <version.gson>2.11.0</version.gson>
    <version.caffeine>3.1.8</version.caffeine>
  </properties>

  <modules>
    <module>extension</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.cadenzaflow.bpm</groupId>
        <artifactId>cadenzaflow-engine</artifactId>
        <version>${version.cadenzaflow}</version>
      </dependency>
      <dependency>
        <groupId>org.cadenzaflow.commons</groupId>
        <artifactId>cadenzaflow-commons-logging</artifactId>
        <version>${version.cadenzaflow}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework</groupId>
        <artifactId>spring-web</artifactId>
        <version>${version.spring-web}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.httpcomponents</groupId>
        <artifactId>httpclient</artifactId>
        <version>${version.httpclient}</version>
      </dependency>
      <dependency>
        <groupId>commons-codec</groupId>
        <artifactId>commons-codec</artifactId>
        <version>${version.commons-codec}</version>
      </dependency>
      <dependency>
        <groupId>com.google.code.gson</groupId>
        <artifactId>gson</artifactId>
        <version>${version.gson}</version>
      </dependency>
      <dependency>
        <groupId>com.github.ben-manes.caffeine</groupId>
        <artifactId>caffeine</artifactId>
        <version>${version.caffeine}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <repositories>
    <!-- CadenzaFlow artifacts (engine, commons) are published here, not on Maven Central -->
    <repository>
      <id>cadenzaflow-nexus</id>
      <url>https://nexus.cadenzaflow.com/repository/cadenzaflow-nexus</url>
    </repository>
  </repositories>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <release>${version.java}</release>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <scm>
    <connection>scm:git:https://github.com/cadenzaflow/cadenzaflow-keycloak.git</connection>
    <developerConnection>scm:git:https://github.com/cadenzaflow/cadenzaflow-keycloak.git</developerConnection>
    <url>https://github.com/cadenzaflow/cadenzaflow-keycloak</url>
  </scm>
</project>
