<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.cadenzaflow.bpm.extension</groupId>
  <artifactId>cadenzaflow-keycloak-root</artifactId>
  <version>1.1.2-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>CadenzaFlow - engine plugins - identity - keycloak - root</name>
  <description>
    CadenzaFlow Identity Provider Plugin for Keycloak. Fork of
    cibseven-keycloak (the maintained continuation of the EOL
    camunda-platform-7-keycloak community plugin), re-namespaced to
    org.cadenzaflow. Two dependency lines: the primary artifact keeps
    the upstream spring-web 6 / httpclient5 code (Java 17 - Run, Spring Boot
    starter, jakarta); the -java11 artifact ports the HTTP wiring to
    spring-web 5.3 / httpclient 4 for the javax Tomcat distribution (JDK 11).
  </description>
  <url>https://github.com/cadenzaflow/cadenzaflow-keycloak</url>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- the engine this plugin is built and tested against. Keep this on a
         version that is available on Maven Central: since this plugin is
         published there too, a consumer outside our network must be able to
         resolve everything the published POMs mention. 1.2.1 is the first
         platform release on Central that carries the -4 starter family. -->
    <version.cadenzaflow>1.2.1</version.cadenzaflow>

    <!-- primary line (upstream code, Java 17): Run / SB starter / jakarta -->
    <version.spring-web6>6.2.11</version.spring-web6>
    <version.httpclient5>5.4.1</version.httpclient5>

    <!-- spring-7 line (-4 artifact): Spring Boot 4 / starter-4 family -->
    <version.spring-web7>7.0.8</version.spring-web7>
    <version.spring-boot4>4.0.7</version.spring-boot4>

    <!-- java11 line: javax Tomcat distribution -->
    <version.spring-web5>5.3.39</version.spring-web5>
    <version.httpclient4>4.5.14</version.httpclient4>

    <version.commons-codec>1.17.1</version.commons-codec>
    <version.gson>2.11.0</version.gson>
    <version.caffeine>3.1.8</version.caffeine>

    <!-- test stack (primary extension module only) -->
    <version.h2>2.3.232</version.h2>
    <version.awaitility>4.3.0</version.awaitility>
    <!-- Keycloak Testcontainer version must match the Testcontainers version
         it brings in transitively, see
         https://github.com/dasniko/testcontainers-keycloak/blob/main/docs/versions.md -->
    <version.testcontainers-keycloak>4.1.1</version.testcontainers-keycloak>
  </properties>

  <modules>
    <module>extension</module>
    <module>extension-4</module>
    <module>extension-java11</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <!-- spring-web and the http client are intentionally NOT managed here:
           the two modules use different major lines of both -->
      <dependency>
        <groupId>org.cadenzaflow.bpm</groupId>
        <artifactId>cadenzaflow-engine</artifactId>
        <version>${version.cadenzaflow}</version>
      </dependency>
      <dependency>
        <groupId>org.cadenzaflow.commons</groupId>
        <artifactId>cadenzaflow-commons-logging</artifactId>
        <version>${version.cadenzaflow}</version>
      </dependency>
      <dependency>
        <groupId>commons-codec</groupId>
        <artifactId>commons-codec</artifactId>
        <version>${version.commons-codec}</version>
      </dependency>
      <dependency>
        <groupId>com.google.code.gson</groupId>
        <artifactId>gson</artifactId>
        <version>${version.gson}</version>
      </dependency>
      <dependency>
        <groupId>com.github.ben-manes.caffeine</groupId>
        <artifactId>caffeine</artifactId>
        <version>${version.caffeine}</version>
      </dependency>

      <!-- test dependencies (used by the primary extension module; the
           spring-boot starter-test line is Boot 3.5 / spring 6, matching the
           primary module - do NOT add it to the java11 module) -->
      <dependency>
        <groupId>org.cadenzaflow.bpm.springboot</groupId>
        <artifactId>cadenzaflow-bpm-spring-boot-starter-test</artifactId>
        <version>${version.cadenzaflow}</version>
      </dependency>
      <dependency>
        <groupId>com.h2database</groupId>
        <artifactId>h2</artifactId>
        <version>${version.h2}</version>
      </dependency>
      <dependency>
        <groupId>org.awaitility</groupId>
        <artifactId>awaitility</artifactId>
        <version>${version.awaitility}</version>
      </dependency>
      <dependency>
        <groupId>com.github.dasniko</groupId>
        <artifactId>testcontainers-keycloak</artifactId>
        <version>${version.testcontainers-keycloak}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!--
    No <repositories> here on purpose.

    This used to point at the CadenzaFlow Nexus, because the engine and commons
    artifacts were only published there. Since platform 1.2.1 they are on Maven
    Central, so the build resolves from Central alone - and, more importantly,
    so does anyone consuming this plugin: a repository declared here would end
    up in the PUBLISHED POM and silently send every consumer's build to our
    Nexus. Verified: engine, commons-logging and starter-test all resolve at
    ${version.cadenzaflow} from Central.
  -->

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>build-helper-maven-plugin</artifactId>
          <version>3.6.0</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <scm>
    <connection>scm:git:https://github.com/cadenzaflow/cadenzaflow-keycloak.git</connection>
    <developerConnection>scm:git:https://github.com/cadenzaflow/cadenzaflow-keycloak.git</developerConnection>
    <url>https://github.com/cadenzaflow/cadenzaflow-keycloak</url>
  </scm>

  <!-- required by Maven Central; matches the platform's own developers block -->
  <developers>
    <developer>
      <id>cadenzaflow</id>
      <name>CadenzaFlow Platform Community</name>
      <organization>cadenzaflow.org</organization>
      <organizationUrl>https://www.cadenzaflow.com</organizationUrl>
    </developer>
  </developers>

  <profiles>
    <!--
      Publish to Maven Central, in addition to the CadenzaFlow Nexus.

      Central needs three things the ordinary Nexus deploy does not: a sources
      jar, a javadoc jar, and a GPG signature for every artifact. It also does
      not accept a plain Maven deploy - Sonatype's plugin collects the whole
      reactor into one signed bundle and uploads that - so the standard deploy
      is switched off here.

      autoPublish stays false and waitUntil stops at "validated" on purpose:
      the upload is checked but nothing goes public until a human presses
      Publish in the Central portal. Publishing is irreversible - a version
      number can never be reused - so that click stays a human decision.

      Note SNAPSHOTs cannot go to Central; deploy a release version.
    -->
    <profile>
      <id>central-publish</id>
      <properties>
        <!-- no distributionManagement in this POM, so the standard deploy
             would fail outright; the bundle upload replaces it -->
        <maven.deploy.skip>true</maven.deploy.skip>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.11.2</version>
            <configuration>
              <!-- Central requires the jar to exist, not to be immaculate;
                   doclint would fail the release over missing @param tags
                   inherited from upstream. -->
              <doclint>none</doclint>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.7</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
                <configuration>
                  <!-- CI has no terminal to type a passphrase into -->
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.8.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
              <waitUntil>validated</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
