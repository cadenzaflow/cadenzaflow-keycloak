<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
	  <groupId>org.cadenzaflow.bpm.extension</groupId>
	  <artifactId>cadenzaflow-keycloak-root</artifactId>
      <version>1.0.1-SNAPSHOT</version>
	</parent>

    <artifactId>cadenzaflow-keycloak-java11</artifactId>

	<packaging>jar</packaging>
    <name>CadenzaFlow - engine plugins - identity - keycloak - extension (Java 11)</name>
	<description>
	  Java 11 line of the CadenzaFlow Keycloak identity plugin for the javax
	  Tomcat distribution: same sources as the primary artifact except
	  KeycloakIdentityProviderFactory, whose HTTP wiring is ported to
	  spring-web 5.3 / httpclient 4 (spring-web 6 requires Java 17).
	</description>

	<properties>
		<failOnMissingWebXml>false</failOnMissingWebXml>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.cadenzaflow.bpm</groupId>
			<artifactId>cadenzaflow-engine</artifactId>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-web</artifactId>
			<version>${version.spring-web5}</version>
		</dependency>

		<dependency>
			<groupId>org.cadenzaflow.commons</groupId>
			<artifactId>cadenzaflow-commons-logging</artifactId>
		</dependency>

		<dependency>
			<groupId>org.apache.httpcomponents</groupId>
			<artifactId>httpclient</artifactId>
			<version>${version.httpclient4}</version>
		</dependency>

		<dependency>
			<groupId>commons-codec</groupId>
			<artifactId>commons-codec</artifactId>
		</dependency>

        <dependency>
          <groupId>com.google.code.gson</groupId>
          <artifactId>gson</artifactId>
        </dependency>

		<dependency>
			<groupId>com.github.ben-manes.caffeine</groupId>
			<artifactId>caffeine</artifactId>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<!-- share the primary module sources; the factory is excluded
				     below and replaced by this module's hc4-ported copy -->
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>add-shared-sources</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>add-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>${project.basedir}/../extension/src/main/java</source>
							</sources>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<release>11</release>
					<excludes>
						<!-- the shared (spring6/hc5) factory; this module ships its own hc4 port -->
						<exclude>org/cadenzaflow/bpm/extension/keycloak/KeycloakIdentityProviderFactory.java</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
