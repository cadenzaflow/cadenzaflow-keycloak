<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
	  <groupId>org.cadenzaflow.bpm.extension</groupId>
	  <artifactId>cadenzaflow-keycloak-root</artifactId>
      <version>1.0.0-SNAPSHOT</version>
	</parent>

    <artifactId>cadenzaflow-keycloak</artifactId>

	<packaging>jar</packaging>
    <name>CadenzaFlow - engine plugins - identity - keycloak - extension</name>
	<description>A CadenzaFlow Identity Provider Plugin for Keycloak</description>

	<properties>
		<failOnMissingWebXml>false</failOnMissingWebXml>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.cadenzaflow.bpm</groupId>
			<artifactId>cadenzaflow-engine</artifactId>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-web</artifactId>
		</dependency>

		<dependency>
			<groupId>org.cadenzaflow.commons</groupId>
			<artifactId>cadenzaflow-commons-logging</artifactId>
		</dependency>

		<!-- http client 4.x: the Java 11 line (spring-web 5.3's
		     HttpComponentsClientHttpRequestFactory is built on it) -->
		<dependency>
			<groupId>org.apache.httpcomponents</groupId>
			<artifactId>httpclient</artifactId>
		</dependency>

		<dependency>
			<groupId>commons-codec</groupId>
			<artifactId>commons-codec</artifactId>
		</dependency>

        <dependency>
          <groupId>com.google.code.gson</groupId>
          <artifactId>gson</artifactId>
        </dependency>

		<dependency>
			<groupId>com.github.ben-manes.caffeine</groupId>
			<artifactId>caffeine</artifactId>
		</dependency>

		<!-- Test dependencies are intentionally absent for now: the upstream
		     test suite (Spring Boot 3.5 + dasniko testcontainers-keycloak,
		     both Java 17) is parked under upstream-tests/ and will be migrated
		     to the CadenzaFlow starter-test in a follow-up. -->
	</dependencies>
</project>
